# Lives in /opt/edge/sites/ on the server. TLS for wystore.ru ends here; the
# pages come from the wystore-web container (deploy/server/docker-compose.yml).
www.wystore.ru {
	redir https://wystore.ru{uri} permanent
}

wystore.ru {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# The visit counter (shared GoatCounter, see wyrtensi/stats deploy/server)
	# is reached through the site itself. Only the script and the count endpoint
	# pass; the dashboard stays on stats.wyrtensi.ru.
	@counter path /stats/count /stats/count.js
	handle @counter {
		uri replace /stats/ /admin/
		reverse_proxy goatcounter:8080 {
			header_up Host stats.wyrtensi.ru
		}
	}

	handle {
		reverse_proxy wystore-web:80
	}

	# Access log without IP addresses (and without forwarded-for or cookie
	# headers); stats.wyrtensi.ru counts bots from these lines by User-Agent.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>remote_port delete
				request>headers>X-Forwarded-For delete
				request>headers>X-Real-Ip delete
				request>headers>Cookie delete
			}
		}
	}
}
