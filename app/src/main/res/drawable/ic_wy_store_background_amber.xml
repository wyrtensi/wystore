<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Wy Hub glass: graphite a shade lighter at the top, as the app's panels are. The
         gradient spans the part a launcher shows (18 to 90), not the whole layer. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="18"
                android:endX="0"
                android:endY="90"
                android:startColor="#FF2B2C32"
                android:endColor="#FF17181C" />
        </aapt:attr>
    </path>
    <!-- The panels' wash of the accent, low in one corner. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="18"
                android:centerY="90"
                android:gradientRadius="80">
                <item android:offset="0" android:color="#BF976F20" />
                <item android:offset="0.55" android:color="#2E976F20" />
                <item android:offset="1" android:color="#00976F20" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
