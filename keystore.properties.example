# Release signing. Copy to keystore.properties, which is gitignored and must never be committed.
# All four values are required; with any of them missing the release build stays unsigned rather
# than failing halfway through signing.
#
# storeFile is resolved against the repository root.
#
# In CI these come from the environment instead: WYSTORE_KEYSTORE, WYSTORE_KEYSTORE_PASSWORD,
# WYSTORE_KEY_ALIAS, WYSTORE_KEY_PASSWORD.
storeFile=outputs/wystore-release.jks
storePassword=
keyAlias=wystore
keyPassword=
